{
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "routes": [
    {
      "route": "/api/saves",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/saves/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/runs",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/runs/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/health",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/static-data",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/static-data/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/runtime-config.js"
    }
  ]
}
