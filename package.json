{
  "name": "my-litrpg-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-runtime-config.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:performance": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/performanceEffects.test.js",
    "simulate": "node sim_gamestart_fixed.js",
    "simulate:quick": "node sim_gamestart_fixed.js --runs 10 --logs false",
    "simulate:csv": "node sim_gamestart_fixed.js --format csv",
    "simulate:full": "node sim_gamestart_fixed.js --runs 100",
    "analyze:middleware": "node scripts/analyze-middleware-dependencies.cjs",
    "analyze:middleware:json": "node scripts/analyze-middleware-dependencies.cjs --format=json",
    "analyze:middleware:md": "node scripts/analyze-middleware-dependencies.cjs --format=markdown",
    "analyze:graph": "node scripts/generate-dependency-graph.cjs --output=docs/MIDDLEWARE_DEPENDENCY_GRAPH.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^29.7.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "<rootDir>/tests/skillEffects.test.js",
      "<rootDir>/tests/endToEndEffects.test.js",
      "<rootDir>/tests/magnitudeCapsFusion.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/backups/"
    ]
  }
}
