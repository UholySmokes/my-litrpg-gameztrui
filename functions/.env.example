GENKIT_VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
# Restrict resource detection to local/process/container/GCP detectors to avoid Azure probes.
# OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance,container,gcp
AI_TEXT_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TEMPERATURE=0.8
# OPENAI_ALLOWED_MODELS=gpt-5.4-mini,gpt-5.4
# OPENAI_TIMEOUT_MS=120000

# Storage backend for /api/saves (file, firestore, dataconnect, or supabase)
# GAME_DB_STORAGE=file
# GAME_DB_PATH=.data/game-db.json
# GAME_SAVES_COLLECTION=game_saves

# Supabase-backed saves + sync persistence
# Prefer the explicit per-surface overrides for now because some non-save stores
# in this repo still remain Firebase-backed.
# GAME_DB_STORAGE=supabase
# GAME_SAVES_STORAGE=supabase
# SYNC_DB_STORAGE=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# Optional when a route or helper needs the project publishable key in a server context:
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional table overrides when you do not want the defaults:
# SYNC_RUNS_COLLECTION=sync_runs
# SYNC_EVENTS_COLLECTION=run_events
# SYNC_PROFILES_COLLECTION=sync_profiles

# Narrate run polling state (used by /api/narrate/start and /api/narrate/poll)
# NARRATE_RUNS_COLLECTION=narrate_runs
# NARRATE_RUNS_FILE_PATH=.data/narrate-runs.json
# NARRATE_RUN_TTL_MS=300000

# Local dev fallback auth for /api/saves
# DEV_USER_ID=local-dev
# DEV_USER_EMAIL=local-dev@example.com
# DEV_AUTH_ENABLED=true

# AI Provider Configuration
# Set AI_TEXT_PROVIDER to one of: openai, openrouter, cerebras, or gemini (default: openai)
# AI_TEXT_PROVIDER=openai

# Option A (simple): Gemini Developer API key
# GOOGLE_GENAI_API_KEY=your_google_genai_api_key

# OpenAI Responses API key (primary provider when AI_TEXT_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TEMPERATURE=0.8
# OPENAI_ALLOWED_MODELS=gpt-5.4-mini,gpt-5.4

# OpenRouter API key (when AI_TEXT_PROVIDER=openrouter)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=openai/gpt-4-turbo
# OPENROUTER_TEMPERATURE=0.8
# OPENROUTER_ALLOWED_MODELS=openai/gpt-4-turbo,openai/gpt-4,anthropic/claude-3-opus

# Cerebras API key (when AI_TEXT_PROVIDER=cerebras)
# Start with llama3.1-8b for the broadest account compatibility, then raise quality with CEREBRAS_MODEL as needed.
# CEREBRAS_API_KEY=your_cerebras_api_key
# CEREBRAS_MODEL=llama3.1-8b
# CEREBRAS_TEMPERATURE=0.8
# CEREBRAS_ALLOWED_MODELS=llama3.1-8b,gpt-oss-120b
# CEREBRAS_TIMEOUT_MS=120000

# Option B (Vertex ADC): set credentials path and keep GOOGLE_GENAI_API_KEY unset
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json

# Bulk generation pipeline (quest/lore + 2D assets)
# BULK_GEN_ENABLED=true
# BULK_GEN_ALLOWED_USER_IDS=uid_1,uid_2
# When unset, only BULK_GEN_INTERNAL_TOKEN callers may access bulk-gen routes.
# BULK_GEN_INTERNAL_TOKEN=replace_with_strong_random_token
# BULK_GEN_CREDIT_EXPIRY_DATE=2026-03-10T00:00:00Z
# BULK_GEN_INITIAL_CREDITS_EUR=2800
# BULK_GEN_STOP_THRESHOLD_EUR=120
# BULK_GEN_BATCH_SIZE=10
# BULK_GEN_PENDING_BUFFER=120
# BULK_GEN_DEFAULT_QUEST_COUNT=20000
# BULK_GEN_DEFAULT_LORE_COUNT=8000
# BULK_GEN_DEFAULT_ASSET_COUNT=12000
# BULK_GEN_MAX_QUEST_COUNT=50000
# BULK_GEN_MAX_LORE_COUNT=30000
# BULK_GEN_MAX_ASSET_COUNT=30000
# BULK_GEN_TEXT_MODEL=gemini-2.5-flash
# BULK_GEN_TEXT_COST_PER_OUTPUT_EUR=0.002
# BULK_GEN_IMAGE_MODEL=imagen-4.0-fast-generate-001
# Optional higher-burn presets:
# imagen-4.0-generate-001
# imagen-4.0-ultra-generate-001
# BULK_GEN_IMAGE_LOCATION=global
# BULK_GEN_IMAGE_VARIANTS=4
# BULK_GEN_IMAGE_ASPECT_RATIO=1:1
# Optional manual override. If unset, the pipeline infers current Imagen 4 pricing defaults:
# fast=0.02, generate=0.04, ultra=0.06 EUR per image variant
# BULK_GEN_IMAGE_COST_PER_VARIANT_EUR=0.02
# BULK_GEN_STORAGE_BUCKET=your-project.appspot.com
# BULK_GEN_STORAGE_PREFIX=bulk-generation
