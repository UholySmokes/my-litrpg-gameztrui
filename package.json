{
  "name": "my-litrpg-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "npx kill-port 5173 && vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "npx kill-port 5000 5001 4000 4400 4500 && firebase emulators:start --only hosting,functions",
    "dev:stack": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "build": "vite build",
    "postbuild": "node scripts/generate-runtime-config.js && node scripts/generate-godot-config.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-cache",
    "test:firestore-rules": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/security/firestoreRules.test.js --runInBand --no-cache",
    "test:firestore-rules:emulator": "node scripts/run-firestore-rules-emulator.mjs",
    "test:performance": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/performanceEffects.test.js",
    "test:godot:headless": "node scripts/run-godot-headless.mjs",
    "test:godot:perf": "node scripts/run-godot-perf-probe.mjs",
    "simulate": "node sim_gamestart_fixed.js",
    "simulate:quick": "node sim_gamestart_fixed.js --runs 10 --logs false",
    "simulate:csv": "node sim_gamestart_fixed.js --format csv",
    "simulate:full": "node sim_gamestart_fixed.js --runs 100",
    "validate:registries": "node scripts/validate-registries.mjs",
    "validate:archetypes": "node scripts/validate-archetypes.mjs",
    "generate:godot-config": "node scripts/generate-godot-config.js",
    "generate:godot-assets:placeholder": "powershell -ExecutionPolicy Bypass -File scripts/generate-godot-placeholder-assets.ps1"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@genkit-ai/firebase": "^1.28.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.1",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/semantic-conventions": "^1.25.1",
    "@voidverse/game-core": "workspace:*",
    "@voidverse/game-schemas": "workspace:*",
    "dotenv": "^17.2.4",
    "firebase": "^12.9.0",
    "js-yaml": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-jest": "^30.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^14.7.0",
    "globals": "^16.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "kill-port": "^2.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "overrides": {
    "test-exclude": "^7.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "<rootDir>/tests/skillEffects.test.js",
      "<rootDir>/tests/endToEndEffects.test.js",
      "<rootDir>/tests/magnitudeCapsFusion.test.js",
      "<rootDir>/.trae/",
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@voidverse/game-core$": "<rootDir>/packages/game-core/src/index.js",
      "^@voidverse/game-core/(.*)$": "<rootDir>/packages/game-core/src/$1",
      "^@voidverse/game-schemas$": "<rootDir>/packages/game-schemas/src/index.js",
      "^@voidverse/game-schemas/(.*)$": "<rootDir>/packages/game-schemas/src/$1",
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "\\.(jpg|jpeg|png|gif|webp|svg)$": "<rootDir>/tests/__mocks__/fileMock.js"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/backups/",
      "<rootDir>/.trae/",
      "<rootDir>/src/dataconnect-generated/",
      "<rootDir>/api/src/dataconnect-generated/",
      "<rootDir>/packages/game-core/src/dataconnect-generated/",
      "<rootDir>/packages/game-schemas/src/dataconnect-generated/"
    ]
  }
}
