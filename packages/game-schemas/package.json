{
  "name": "@voidverse/game-schemas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./actions": {
      "types": "./src/actions.d.ts",
      "default": "./src/actions.js"
    },
    "./state": {
      "types": "./src/state.d.ts",
      "default": "./src/state.js"
    },
    "./validation": {
      "types": "./src/validation.d.ts",
      "default": "./src/validation.js"
    },
    "./engine": {
      "types": "./src/engine.d.ts",
      "default": "./src/engine.js"
    },
    "./sync": {
      "types": "./src/sync.d.ts",
      "default": "./src/sync.js"
    },
    "./content": {
      "types": "./src/content.d.ts",
      "default": "./src/content.js"
    }
