{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/runtime-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/narrate",
        "function": {
          "functionId": "apiNarrate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/narrate-start",
        "function": {
          "functionId": "apiNarrate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/narrate-poll",
        "function": {
          "functionId": "apiNarrate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/story/**",
        "function": {
          "functionId": "apiNarrate",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/sync/**",
        "function": {
          "functionId": "apiSync",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/saves/**",
        "function": {
          "functionId": "apiSync",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/health",
        "function": {
          "functionId": "apiAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/agents",
        "function": {
          "functionId": "apiAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/agents/run",
        "function": {
          "functionId": "apiAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/telemetry",
        "function": {
          "functionId": "apiAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/bulk-gen/**",
        "function": {
          "functionId": "apiAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "function": {
          "functionId": "apiAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "firestore": {
      "port": 8080
    },
    "dataconnect": {
      "dataDir": ".cache/dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  }
}
