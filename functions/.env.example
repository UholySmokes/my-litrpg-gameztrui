GENKIT_VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8

# Storage backend for /api/saves (firestore or file)
# GAME_DB_STORAGE=file
# GAME_DB_PATH=.data/game-db.json
# GAME_SAVES_COLLECTION=game_saves

# Local dev fallback auth for /api/saves
# DEV_USER_ID=local-dev
# DEV_USER_EMAIL=local-dev@example.com

# Option A (simple): Gemini Developer API key
# GOOGLE_GENAI_API_KEY=your_google_genai_api_key

# Option B (Vertex ADC): set credentials path and keep GOOGLE_GENAI_API_KEY unset
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\service-account.json
