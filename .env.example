# Narrative API (client-side)
# Set to a full URL for static hosting (e.g. https://your-host/api/narrate).
# Leave empty if deploying frontend and API on the same host.
VITE_NARRATE_ENDPOINT=

# API base (client-side)
# Used to derive /api/narrate when VITE_NARRATE_ENDPOINT is not set.
VITE_API_BASE_URL=

# Narration request timeout (milliseconds)
# Keep this slightly higher than backend `NARRATE_RUN_TIMEOUT_MS`.
# VITE_NARRATE_TIMEOUT_MS=150000

# Node/OpenTelemetry tracing (optional; used by Node entrypoints)
# TRACE_ENABLED=false
# OTEL_TRACES_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318


# Cloud Saves / API
# Optional override for saves endpoint
# VITE_SAVES_ENDPOINT=https://your-api-host/api/saves

# Supabase Auth + persistence
# Canonical Vite-style keys for this repo
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-key

# Compatibility fallback keys if a snippet uses NEXT_PUBLIC naming
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key

# Auth provider (optional; app-specific)
VITE_AUTH_PROVIDER=

# Dev-only override (bypasses auth)
# VITE_DEV_USER_ID=dev-user
# VITE_DEV_USER_EMAIL=dev-user@example.com

# Disable cloud saves entirely
# VITE_CLOUD_SAVES_DISABLED=true
